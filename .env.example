# Copy this file to .env and fill in the values. .env is git-ignored; this file is safe to commit.

# Clio developer app (https://developers.clio.com/apps): use the app's KEY, not the numeric App ID.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://127.0.0.1:8765/callback
# US instance. Tokens from app.clio.com do not work against EU/CA/AU.
CLIO_BASE=https://app.clio.com
# Which matter to digest (Clio matter search).
MATTER_QUERY=Sapini

# Model provider
ANTHROPIC_API_KEY=
# Only if the API returns "not scoped to a workspace": the workspace ID (wrkspc_...) from the Console.
ANTHROPIC_WORKSPACE_ID=
MODEL_DIGEST=claude-sonnet-5-5
MODEL_TRIAGE=claude-haiku-4-5-20251001

# Fallback statute of limitations when Clio has no limitations task (years from the date of loss).
SOL_YEARS=3
